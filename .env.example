# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The one email address allowed to use the app. Anyone else is turned away,
# even if they somehow get an account.
ALLOWED_EMAIL=you@example.com

# Server-only. Used by scheduled jobs (the Sunday snapshot) that run without
# anyone signed in. Supabase → Project Settings → API Keys → Secret keys.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string. Vercel sends it with each scheduled job so strangers
# can't trigger them. Generate one with: openssl rand -hex 32
CRON_SECRET=change-me
